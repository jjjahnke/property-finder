FROM python:3.10-slim

WORKDIR /app

# Install system dependencies for psycopg2
RUN apt-get update && apt-get install -y libpq-dev gcc build-essential gdal-bin libgdal-dev python3-dev && rm -rf /var/lib/apt/lists/*

# Copy requirements (assuming we use the project's main requirements)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install PyTorch with CUDA 11.8 support for Tesla P100 (Pascal)
RUN pip install torch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 --index-url https://download.pytorch.org/whl/cu118

# Install compatible dependencies
RUN pip install "numpy<2" "transformers==4.38.2" "sentence-transformers==2.7.0" qdrant-client

# Copy the application code
COPY ingestion/indexer.py .
COPY app/ app/ 
# Copy app/ folder just in case we import from it, though indexer.py is self-contained mostly.
# Actually, indexer.py imports sqlalchemy directly.

CMD ["python", "indexer.py"]
